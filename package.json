{
  "name": "interactive-photo",
  "version": "0.1.0",
  "private": true,
  "description": "API-first AI interactive photo-to-music web experience — one reusable scene engine, five configurable presets.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "pnpm --filter @interactive-photo/web dev",
    "build": "pnpm -r --filter=./packages/* build && pnpm --filter @interactive-photo/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @interactive-photo/web test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "check:secrets": "bash scripts/check-secrets.sh",
    "provider:doctor": "python3 scripts/provider-doctor.py"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
